# Backend origin baked in at build time. Leave empty in local Vite so `/api`
# is proxied. Production on Netlify ignores VITE_API_MODE.
VITE_API_BASE_URL=

# Development only (put these in .env.local, then restart `npm run dev`):
# VITE_API_MODE=local
# VITE_API_LOCAL=http://127.0.0.1:5050
# VITE_API_RAILWAY=https://timbowebapi.up.railway.app

# Optional. Must match TimboWebApi GOOGLE_CLIENT_ID. Leave empty to hide Google sign-in.
# Google accounts are created as customers unless an admin promotes them on the server.
VITE_GOOGLE_CLIENT_ID=
